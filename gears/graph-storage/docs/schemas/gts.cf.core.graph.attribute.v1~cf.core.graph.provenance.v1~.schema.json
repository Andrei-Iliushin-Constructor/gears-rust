{
  "$id": "gts://gts.cf.core.graph.attribute.v1~cf.core.graph.provenance.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Who asserted a derived fact, with what, and how confidently. Retained across scope replacement together with the edge that carries it.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gts://gts.cf.core.graph.attribute.v1~"
    },
    {
      "type": "object",
      "properties": {
        "produced_by": {
          "type": "string",
          "minLength": 1,
          "description": "Analyzer identity."
        },
        "method": {
          "type": "string",
          "description": "Algorithm or rule that produced the assertion."
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model": {
          "type": "string",
          "description": "Model or tool version behind the assertion, when one applies."
        }
      },
      "required": [
        "produced_by",
        "produced_at"
      ]
    }
  ]
}